datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

enum UserRole {
  ADMIN
  STUDENT
}

model User {
  id               String            @id @default(uuid()) @db.Uuid // Integrasi Supabase UUID
  email            String            @unique
  name             String
  role             UserRole          @default(STUDENT)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  // Relasi
  progress         UserProgress[]
  exercise_results ExerciseResult[]
  ai_chats         AiChatHistory[]
  articles         Article[]         @relation("AuthorArticles")

  @@map("users")
}

model Module {
  id           Int          @id @default(autoincrement())
  title        String
  description  String       @db.Text
  sort_order   Int
  is_published Boolean      @default(false)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  // Relasi
  lessons      Lesson[]

  @@map("modules")
}

model Lesson {
  id           Int            @id @default(autoincrement())
  module_id    Int
  title        String
  content      String         @db.Text // Kapasitas text block LaTeX besar
  sort_order   Int
  is_published Boolean        @default(false)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  // Relasi
  module       Module         @relation(fields: [module_id], references: [id], onDelete: Cascade)
  exercises    Exercise[]
  progress     UserProgress[]

  @@map("lessons")
}

model Exercise {
  id           Int              @id @default(autoincrement())
  lesson_id    Int
  instruction  String           @db.Text
  starter_code String           @db.Text
  solution_code String          @db.Text
  is_published Boolean          @default(false)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  // Relasi
  lesson       Lesson           @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  results      ExerciseResult[]
  ai_chats     AiChatHistory[]

  @@map("exercises")
}

model ExerciseResult {
  id            Int      @id @default(autoincrement())
  user_id       String   @db.Uuid
  exercise_id   Int
  submitted_code String  @db.Text
  is_success    Boolean  @default(false)
  pdf_url       String?  @db.VarChar(255)
  error_log     String?  @db.Text
  created_at    DateTime @default(now())

  // Relasi
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise      Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([exercise_id])
  @@map("exercise_results")
}

model UserProgress {
  id           Int      @id @default(autoincrement())
  user_id      String   @db.Uuid
  lesson_id    Int
  is_completed Boolean  @default(false)
  updated_at   DateTime @updatedAt

  // Relasi
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  // Composite Unique Index untuk mengatasi Double Progress Bug
  @@unique([user_id, lesson_id])
  @@map("user_progress")
}

model AiChatHistory {
  id          Int       @id @default(autoincrement())
  user_id     String    @db.Uuid
  exercise_id Int?      // Opsional untuk context-aware exercise error
  session_id  String    @db.VarChar(255) // Pengelompokan sesi obrolan
  message     String    @db.Text
  response    String    @db.Text
  created_at  DateTime  @default(now())

  // Relasi
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise    Exercise? @relation(fields: [exercise_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([session_id])
  @@map("ai_chat_history")
}

model Article {
  id           Int      @id @default(autoincrement())
  title        String
  content      String   @db.Text
  author_id    String   @db.Uuid
  is_published Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relasi
  author       User     @relation("AuthorArticles", fields: [author_id], references: [id])

  @@map("articles")
}
